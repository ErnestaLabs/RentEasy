{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": false,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@aceternity": "https://shadcnregistry.com/r/aceternity/{name}.json",
    "@creative-tim": "https://shadcnregistry.com/r/creative-tim/{name}.json",
    "@magicui": "https://shadcnregistry.com/r/magicui/{name}.json",
    "@magicui-pro": "https://shadcnregistry.com/r/magicui-pro/{name}.json",
    "@paceui-ui": "https://shadcnregistry.com/r/paceui-ui/{name}.json",
    "@react-bits": "https://shadcnregistry.com/r/react-bits/{name}.json"
  }
}
